# 部署配置
DIFY_API_KEY=app-change-me
JWT_SECRET=change-me-in-production

# Centrifugo 容器配置（docker-compose.centrifugo.yml 读取）
# 用 `openssl rand -hex 16` 生成
CENTRIFUGO_SECRET=change-me-32-bytes-hex
CENTRIFUGO_API_KEY=change-me-32-bytes-hex
# 与 gateway .env 中 CENTRIFUGO_PROXY_SECRET 使用同一个值
CENTRIFUGO_PROXY_SECRET=change-me-same-as-gateway-CENTRIFUGO_PROXY_SECRET

# yx_postgres / yx_redis 配置（docker-compose.yxdata.yml 读取）
# pg superuser（不是业务 user）；业务 user yxg 由 03-pg-migrate.sh 建
YX_POSTGRES_USER=yx_admin
YX_POSTGRES_PASSWORD=change-me-strong-pass
YX_POSTGRES_DB=yixiaoguan
YX_REDIS_PASSWORD=change-me-strong-pass
