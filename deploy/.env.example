# 部署配置
DIFY_API_KEY=app-change-me
JWT_SECRET=change-me-in-production

# Centrifugo 容器配置（docker-compose.centrifugo.yml 读取）
# 用 `openssl rand -hex 16` 生成
CENTRIFUGO_SECRET=change-me-32-bytes-hex
CENTRIFUGO_API_KEY=change-me-32-bytes-hex
# proxy header 注入：值与 gateway .env 中 CENTRIFUGO_PROXY_SECRET 一致
# 注意是 JSON 字符串，等号后不要加引号
CENTRIFUGO_PROXY_STATIC_HTTP_HEADERS={"X-Auth": "change-me-same-as-gateway-CENTRIFUGO_PROXY_SECRET"}
