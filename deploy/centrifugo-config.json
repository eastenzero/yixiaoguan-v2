{
  "client": {
    "allowed_origins": [
      "https://yxg.xiaoguan.site",
      "https://teacher.xiaoguan.site",
      "http://localhost:*"
    ]
  },
  "proxy_subscribe_endpoint": "http://host.docker.internal:8100/api/internal/centrifugo/subscribe",
  "proxy_subscribe_timeout": "2s",
  "proxy_static_http_headers": {
    "X-Auth": "CHANGE_ME_SYNC_WITH_CENTRIFUGO_PROXY_SECRET"
  },
  "channel": {
    "namespaces": [
      {
        "name": "conv",
        "history_size": 100,
        "history_ttl": "5m",
        "force_recovery": true,
        "presence": true,
        "join_leave": false,
        "allow_publish_for_client": true,
        "allow_subscribe_for_client": true
      }
    ]
  }
}
