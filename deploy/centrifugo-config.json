{
  "client": {
    "allowed_origins": [
      "https://yxg.xiaoguan.site",
      "https://teacher.xiaoguan.site",
      "http://localhost:*"
    ]
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "http://host.docker.internal:8100/api/internal/centrifugo/subscribe",
        "timeout": "2s",
        "http": {
          "static_headers": {
            "X-Auth": "CHANGE_ME_SYNC_WITH_CENTRIFUGO_PROXY_SECRET"
          }
        }
      }
    },
    "namespaces": [
      {
        "name": "conv",
        "subscribe_proxy_enabled": true,
        "history_size": 100,
        "history_ttl": "5m",
        "force_recovery": true,
        "presence": true,
        "join_leave": false,
        "allow_publish_for_client": true,
        "allow_subscribe_for_client": true
      }
    ]
  }
}