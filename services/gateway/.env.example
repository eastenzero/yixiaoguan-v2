# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://yxg:yxg_v2_pass@localhost:5432/yixiaoguan_v2
REDIS_URL=redis://localhost:6379/1

# === JWT ===
# Required. Must be a strong random value (>= 32 chars). 
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Gateway will refuse to start if this is empty / weak / a known placeholder.
JWT_SECRET=__GENERATE_A_STRONG_RANDOM_SECRET__
JWT_EXPIRE_HOURS=24

# === Dify ===
DIFY_API_URL=http://localhost:5001/v1
DIFY_API_KEY=app-change-me
DIFY_GLOBAL_DATASET_ID=change-me

