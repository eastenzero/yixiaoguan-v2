# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://yxg:yxg_v2_pass@localhost:5432/yixiaoguan_v2
REDIS_URL=redis://localhost:6379/1

# === JWT ===
# Required. Must be a strong random value (>= 32 chars). 
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Gateway will refuse to start if this is empty / weak / a known placeholder.
JWT_SECRET=__GENERATE_A_STRONG_RANDOM_SECRET__
JWT_EXPIRE_HOURS=24

# === Dify ===
DIFY_API_URL=http://localhost:5001/v1
DIFY_API_KEY=app-change-me
DIFY_GLOBAL_DATASET_ID=change-me

# === Centrifugo 实时通信 ===
# CENTRIFUGO_SECRET 与 deploy/.env 中 CENTRIFUGO_SECRET 一致
# CENTRIFUGO_API_KEY 与 deploy/.env 中 CENTRIFUGO_API_KEY 一致
# CENTRIFUGO_PROXY_SECRET 与 deploy/.env 中 CENTRIFUGO_PROXY_SECRET 一致
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=change-me-32-bytes-hex
CENTRIFUGO_SECRET=change-me-32-bytes-hex
CENTRIFUGO_PROXY_SECRET=change-me-same-as-deploy-CENTRIFUGO_PROXY_SECRET

# === 微信小程序（P1 阶段配置） ===
# WECHAT_MP_APPID=
# WECHAT_MP_SECRET=

# === 企业微信（P1 阶段配置） ===
# WECHAT_WORK_CORPID=
# WECHAT_WORK_AGENT_ID=
# WECHAT_WORK_SECRET=
